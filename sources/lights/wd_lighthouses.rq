SELECT ?item ?itemLabel ?countryLabel ?coord ?admiralty ?arlhs ?nga ?inception WHERE {
  VALUES ?country { wd:Q145 wd:Q27 wd:Q9676 wd:Q785 wd:Q25230 }
  ?item wdt:P31/wdt:P279* wd:Q39715 ;
        wdt:P17 ?country ;
        wdt:P625 ?coord .
  OPTIONAL { ?item wdt:P3562 ?admiralty . }
  OPTIONAL { ?item wdt:P2980 ?arlhs . }
  OPTIONAL { ?item wdt:P3563 ?nga . }
  OPTIONAL { ?item wdt:P571 ?inception . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
